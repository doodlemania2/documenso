# doodlessd backup configuration.
#
# Copy to /etc/doodlessd-backup/backup.env on the server, fill in, then:
#   sudo chown root:root /etc/doodlessd-backup/backup.env
#   sudo chmod 600 /etc/doodlessd-backup/backup.env
#
# Root-only, because it holds the credential to the off-machine repository —
# and by extension to every secret on this host, since the backup set includes
# /etc/oltp-relay and the stacks' .env files.
#
# NOTHING BELOW IS A REAL VALUE.


# ===========================================================================
# 1. THE DESTINATION — this is Derek's decision, not the script's
# ===========================================================================
# A backup stored on the machine it protects is not a backup. If doodlessd
# loses its disk, is ransomwared, or is deleted by the hosting provider, a
# local restic repository dies with it. The whole point of this file is that
# RESTIC_REPOSITORY points somewhere ELSE.
#
# restic speaks several backends and the script does not care which. Pick one:
#
#   SFTP      sftp:backup@some-host:/srv/restic/doodlessd
#             Simplest if there is already a second box. Needs an SSH key for
#             root@doodlessd in that account's authorized_keys — and the remote
#             account should be restricted, because restic needs write access
#             and anything with write access can also delete. Prefer
#             append-only (see RESTIC_APPEND_ONLY note below).
#
#   S3        s3:s3.amazonaws.com/bucket-name/doodlessd
#             or any S3-compatible endpoint. Set AWS_ACCESS_KEY_ID and
#             AWS_SECRET_ACCESS_KEY. Turn on object lock / versioning on the
#             bucket so a compromised host cannot erase history.
#
#   B2        b2:bucket-name:doodlessd
#             Set B2_ACCOUNT_ID and B2_ACCOUNT_KEY. Cheapest of the three for
#             this data volume; lifecycle rules serve the same role as object
#             lock.
#
#   rclone    rclone:remote:path
#             Anything rclone supports (OneDrive, Azure Blob, Google Drive).
#             Adds a dependency and a config file, but reuses a remote that
#             may already exist.
#
# There is deliberately no default here. Leaving it unset makes the script
# refuse to run, which is the correct behaviour — a silently-local "backup"
# is worse than no backup, because it produces a green timer and false
# confidence.
RESTIC_REPOSITORY=REPLACE_ME_choose_a_destination

# The repository password. This encrypts everything before it leaves the host,
# which is what makes it acceptable to ship /etc/oltp-relay and the Documenso
# database to a third-party bucket at all.
#
# Generate:  openssl rand -base64 32
#
# LOSE THIS AND THE BACKUPS ARE UNRECOVERABLE. There is no reset, no escrow,
# no support line. Put it in the password manager BEFORE `restic init`, and
# put a second copy somewhere that does not depend on doodlessd or on the
# password manager being reachable.
RESTIC_PASSWORD=REPLACE_ME_openssl_rand_base64_32

# --- backend credentials: uncomment only the block you actually use ---
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
# AWS_DEFAULT_REGION=us-east-1
#
# B2_ACCOUNT_ID=REPLACE_ME
# B2_ACCOUNT_KEY=REPLACE_ME
#
# For sftp: no variable. Use an SSH key and an entry in /root/.ssh/config, so
# the non-interactive systemd run has no prompt to hang on.


# ===========================================================================
# 2. WHAT GETS BACKED UP
# ===========================================================================
# Postgres containers to dump logically. Space-separated container names.
# See the long comment in doodlessd-backup.sh for why a logical dump is
# mandatory and copying the volume is not enough.
PG_CONTAINERS="documenso-db"

# Extra paths, appended to the built-in list in doodlessd-backup.sh. Use this
# when a new stack appears rather than editing the script.
EXTRA_SOURCES=""

# Where dumps are staged before restic picks them up. Root-only, wiped on exit.
STAGE_DIR="/var/backups/doodlessd"


# ===========================================================================
# 3. RETENTION
# ===========================================================================
# Applied by doodlessd-prune.sh, not by the backup run. Keeping forget/prune
# on its own timer means a slow prune can never delay or fail a backup.
#
# 14 dailies covers "I deleted it last week and only just noticed".
# 8 weeklies + 12 monthlies covers a slow-burning corruption nobody spotted.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
KEEP_YEARLY=3

# Fraction of pack files to actually re-read and verify each prune run.
# `restic check` alone only verifies the metadata tree — it will happily call
# a repository healthy when the underlying blobs have rotted. Reading a
# rotating slice each week means the whole repo gets verified over time
# without a weekly full download.
CHECK_READ_DATA_SUBSET="5%"


# ===========================================================================
# 4. MONITORING — via the oltp-relay that is already on this host
# ===========================================================================
# The host already runs relay-gate (127.0.0.1:18080) in front of an
# OpenTelemetry collector that forwards to SigNoz. The backup job emits to it
# rather than growing a second notification path.
#
# Issue a key with relayctl on the relay host; it is printed exactly once:
#   sudo relayctl issue --tenant doodlessd-backup --owner-repo doodlemania2/documenso
#
# If this is left empty the backup still runs and still succeeds — it just
# does so silently. That is a deliberate fallback, but "silently" is exactly
# how a backup rots, so treat an empty value as a to-do, not a setting.
OTLP_ENDPOINT="http://127.0.0.1:18080"
OTLP_API_KEY=""
