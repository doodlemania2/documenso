# Documenso on doodlessd — copy to `.env` beside docker-compose.yml, fill in,
# then `chmod 600 .env`.
#
# NOTHING IN THIS FILE IS A REAL SECRET. Every value below is a placeholder.
# Never commit the filled-in copy; `.gitignore` already blocks it.
#
# Two consumers read this file and they are not the same thing:
#   1. Compose itself, for the ${...} substitutions in docker-compose.yml
#      (POSTGRES_USER and friends).
#   2. The documenso container, via `env_file:` — which passes the WHOLE file
#      in, including the POSTGRES_* values it does not use. Harmless (it holds
#      the same credential inside NEXT_PRIVATE_DATABASE_URL anyway), but worth
#      knowing before you put anything unrelated in here.
#
# Variable names are not guesses. They come from Documenso's own environment
# reference and their production compose file:
#   https://docs.documenso.com/docs/self-hosting/configuration/environment
#   https://docs.documenso.com/docs/self-hosting/deployment/docker-compose
#   https://github.com/documenso/documenso/blob/main/docker/production/compose.yml


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used by the `database` service to initialise the cluster, and echoed into
# NEXT_PRIVATE_DATABASE_URL below. Change them here and there together.
POSTGRES_USER=documenso
# Generate: openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
# (stripped of / + = because this value is also pasted into a URL below, where
# those characters need percent-encoding and will silently break the DSN)
POSTGRES_PASSWORD=REPLACE_ME_db_password
POSTGRES_DB=documenso

# The connection string the app uses. `database` is the compose service name,
# resolved on the stack's own network — not localhost, not the host IP.
# The password here MUST match POSTGRES_PASSWORD above, character for
# character; there is no cross-check and the failure mode is a boot loop.
NEXT_PRIVATE_DATABASE_URL=postgresql://documenso:REPLACE_ME_db_password@database:5432/documenso

# Prisma's schema declares `directUrl`, and `prisma migrate deploy` reads it from HERE,
# not from NEXT_PRIVATE_DATABASE_URL. Leave it unset and migrations fail with P1012
# "Environment variable not found" — which is quiet, because the container then starts
# the server anyway, crashes on the first query against a table that was never created,
# and restarts. What you see is a crash loop about a missing `public.User` table; the
# actual cause is this line. With a direct Postgres (no pooler) it is the same value.
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgresql://documenso:REPLACE_ME_POSTGRES_PASSWORD@database:5432/documenso

# (An earlier version of this file called the variable above optional — "leave it unset
# and Documenso falls back". It does not fall back. That claim cost a crash loop on the
# first deploy, which is why the note above is as long as it is.)


# ---------------------------------------------------------------------------
# Application secrets — all three are REQUIRED and all three are 32+ chars
# ---------------------------------------------------------------------------
# Generate each one separately (never reuse one value for two variables):
#   openssl rand -base64 32

# Signs and encrypts session cookies. Rotating it logs every user out.
NEXTAUTH_SECRET=REPLACE_ME_openssl_rand_base64_32

# Primary symmetric key for data Documenso encrypts at rest — API tokens,
# 2FA secrets, OAuth credentials. LOSING THIS IS UNRECOVERABLE: a restored
# database without the matching key has ciphertext nobody can read. Store it
# in the password manager the moment you generate it, before the stack starts.
NEXT_PRIVATE_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32

# Secondary key, used for key rotation. Required even though no rotation has
# happened yet — the app refuses to start without it.
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=REPLACE_ME_openssl_rand_base64_32


# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# The public origin, exactly as a browser sees it: scheme, host, no trailing
# slash. It is baked into every signing link and every email, so a wrong value
# here does not produce an error — it produces invitation emails pointing at
# the wrong place. It must be the Cloudflare/NPM hostname, never the loopback
# port.
NEXT_PUBLIC_WEBAPP_URL=https://sign.tdpdf.com

# NEXT_PRIVATE_INTERNAL_WEBAPP_URL is pinned to http://127.0.0.1:3000 in
# docker-compose.yml and deliberately not overridable here.


# ---------------------------------------------------------------------------
# Email (SMTP) — required. Documenso is useless without outbound mail: every
# signing request, reminder and completion notice is an email.
# ---------------------------------------------------------------------------
# Transport: smtp-auth | smtp-api | resend | mailchannels
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=REPLACE_ME_smtp_host
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=REPLACE_ME_smtp_username
# From the mail provider's console. For Microsoft 365 this is an app password
# or a dedicated service mailbox credential, never Derek's own password.
NEXT_PRIVATE_SMTP_PASSWORD=REPLACE_ME_smtp_password
# false = STARTTLS on 587 (the normal case). true = implicit TLS on 465.
NEXT_PRIVATE_SMTP_SECURE=false
# Must be an address the provider will let you send as, or everything lands in
# spam — or is rejected outright by SPF/DMARC.
NEXT_PRIVATE_SMTP_FROM_ADDRESS=REPLACE_ME_noreply@tdpdf.com
NEXT_PRIVATE_SMTP_FROM_NAME=TDPdf Signing

# If the transport is `resend` instead, set this and drop the SMTP_* block:
# NEXT_PRIVATE_RESEND_API_KEY=


# ---------------------------------------------------------------------------
# Signing certificate
# ---------------------------------------------------------------------------
# The transport and the file path are pinned in docker-compose.yml. Only the
# passphrase belongs here. (Key Vault signing, further down, replaces this at
# cutover; the .p12 stays as the rollback.)
#
# Create the .p12 ON THE HOST (never inside the container — a rebuild would
# lose it and every previously signed document would fail to verify against
# the new one):
#
#   cd /home/derek/documenso-stack && mkdir -p secrets && cd secrets
#   openssl genrsa -out private.key 2048
#   openssl req -new -x509 -key private.key -out certificate.crt -days 365 \
#       -subj "/CN=TDPdf Document Signing/O=TDPdf"
#   openssl pkcs12 -export -out cert.p12 -inkey private.key -in certificate.crt
#   rm private.key certificate.crt
#   sudo chown 1001 cert.p12 && sudo chmod 400 cert.p12
#
# The .p12 MUST have a passphrase. Documenso fails with "Failed to get private
# key bags" on a passwordless one, which reads like a corrupt file rather than
# a missing password.
#
# This .p12 is self-signed: it proves the document has not been altered since
# signing, but it is NOT in Adobe's trust list, so Acrobat shows "signature
# validity is unknown" rather than a green check. It stays configured after the
# Key Vault cutover below, because rolling back means using it again.
NEXT_PRIVATE_SIGNING_PASSPHRASE=REPLACE_ME_p12_passphrase

# ---------------------------------------------------------------------------
# Azure Key Vault signing (only with docker-compose.azure-kv.yml)
# ---------------------------------------------------------------------------
# The SSL.com AATL certificate lives in Key Vault `tdpdf-sign` as a
# non-exportable RSA-HSM key (issue #2). The key id, chain path and timestamp
# server are pinned in docker-compose.azure-kv.yml; only the identity of the
# service principal that may sign with the key belongs here. Its certificate
# and private key go in secrets/azure-signer.pem, not in this file.
#
# The tenant is the vault's, NOT stfoafrisco.org: a token from the wrong tenant
# is refused with AKV10032 "Invalid issuer".
# AZURE_TENANT_ID=42d6a804-2370-4a3c-95b4-b785a62c6759
# AZURE_CLIENT_ID=REPLACE_ME_documenso_signer_app_id

# Shown in the signature panel of signed PDFs. Optional but worth setting.
# NEXT_PUBLIC_SIGNING_CONTACT_INFO=support@tdpdf.com


# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Signup is OPEN on sign.tdpdf.com (decided 2026-10-15): TDPdf's Electronic
# Signature feature points everyone at this instance, and an invitation step
# would put overhead between a TDPdf user and their first signature. New
# accounts still verify their email address before they can send anything.
# Set to true to close it again; existing accounts are unaffected.
NEXT_PUBLIC_DISABLE_SIGNUP=false

# Alternative to the above if other people need to self-serve later: allow
# signup but only from our domains.
# NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=tdpdf.com,thedoodleproject.net


# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Upstream default is 5MB. Raise it only with the Cloudflare body limit in
# mind — Cloudflare's free plan caps uploads at 100MB regardless of what this
# says, and the failure appears as a Cloudflare error page, not a Documenso one.
# NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=25

# Documenso phones home with anonymous usage stats by default.
DOCUMENSO_DISABLE_TELEMETRY=true
