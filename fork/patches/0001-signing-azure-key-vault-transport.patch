diff --git a/packages/signing/transports/azure-key-vault.test.ts b/packages/signing/transports/azure-key-vault.test.ts
new file mode 100644
index 0000000..4217c09
--- /dev/null
+++ b/packages/signing/transports/azure-key-vault.test.ts
@@ -0,0 +1,186 @@
+import { constants, generateKeyPairSync, type KeyObject, privateEncrypt, verify, webcrypto } from 'node:crypto';
+
+import type { SignatureAlgorithm as KeyVaultSignatureAlgorithm } from '@azure/keyvault-keys';
+import { PDF } from '@libpdf/core';
+import * as asn1js from 'asn1js';
+import * as pkijs from 'pkijs';
+import { beforeAll, describe, expect, it } from 'vitest';
+
+import { AzureKeyVaultSigner, type AzureKeyVaultSigningClient } from './azure-key-vault';
+
+/**
+ * The signer is tested against a stand-in for Key Vault that does exactly what Key Vault's
+ * RS256/RS384/RS512 `sign` operation does — RSASSA-PKCS1-v1_5 over a digest the caller already
+ * computed — so the round trip below proves the signatures verify, not merely that the right
+ * method was called. Keys and certificates are minted per run: nothing secret is committed.
+ */
+
+// DER DigestInfo prefixes from RFC 8017 §9.2. Key Vault prepends these to the digest it is given;
+// the fake has to as well, or its signatures would not be PKCS#1 v1.5 signatures at all.
+const DIGEST_INFO_PREFIX: Record<string, Buffer> = {
+  RS256: Buffer.from('3031300d060960864801650304020105000420', 'hex'),
+  RS384: Buffer.from('3041300d060960864801650304020205000430', 'hex'),
+  RS512: Buffer.from('3051300d060960864801650304020305000440', 'hex'),
+};
+
+type FakeVault = AzureKeyVaultSigningClient & { calls: Array<{ algorithm: string; digestLength: number }> };
+
+const fakeVault = (privateKey: KeyObject, publicKey: KeyObject): FakeVault => {
+  const calls: FakeVault['calls'] = [];
+
+  return {
+    calls,
+    getPublicKey: () => Promise.resolve(publicKey),
+    sign: (algorithm: KeyVaultSignatureAlgorithm, digest: Uint8Array) => {
+      calls.push({ algorithm, digestLength: digest.length });
+
+      const prefix = DIGEST_INFO_PREFIX[algorithm];
+
+      if (!prefix) {
+        return Promise.reject(new Error(`fake vault: unsupported algorithm ${algorithm}`));
+      }
+
+      const signature = privateEncrypt(
+        { key: privateKey, padding: constants.RSA_PKCS1_PADDING },
+        Buffer.concat([prefix, Buffer.from(digest)]),
+      );
+
+      return Promise.resolve(new Uint8Array(signature));
+    },
+  };
+};
+
+/** A self-signed certificate for `keyPair`, DER. */
+const selfSignedCertificate = async (keyPair: { privateKey: KeyObject; publicKey: KeyObject }) => {
+  pkijs.setEngine('node-webcrypto', new pkijs.CryptoEngine({ name: 'node-webcrypto', crypto: webcrypto as Crypto }));
+
+  const algorithm = { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' };
+  const privateKey = await webcrypto.subtle.importKey(
+    'pkcs8',
+    keyPair.privateKey.export({ type: 'pkcs8', format: 'der' }),
+    algorithm,
+    false,
+    ['sign'],
+  );
+  const publicKey = await webcrypto.subtle.importKey(
+    'spki',
+    keyPair.publicKey.export({ type: 'spki', format: 'der' }),
+    algorithm,
+    true,
+    ['verify'],
+  );
+
+  const certificate = new pkijs.Certificate();
+  certificate.version = 2;
+  certificate.serialNumber = new asn1js.Integer({ value: 1 });
+
+  const commonName = new pkijs.AttributeTypeAndValue({
+    type: '2.5.4.3',
+    value: new asn1js.Utf8String({ value: 'AzureKeyVaultSigner test — not a real certificate' }),
+  });
+  certificate.issuer.typesAndValues.push(commonName);
+  certificate.subject.typesAndValues.push(commonName);
+
+  certificate.notBefore.value = new Date(Date.now() - 60_000);
+  certificate.notAfter.value = new Date(Date.now() + 86_400_000);
+
+  await certificate.subjectPublicKeyInfo.importKey(publicKey);
+  await certificate.sign(privateKey, 'SHA-256');
+
+  return new Uint8Array(certificate.toSchema().toBER(false));
+};
+
+const rsa = (modulusLength = 2048) => generateKeyPairSync('rsa', { modulusLength });
+
+describe('AzureKeyVaultSigner', () => {
+  const keyPair = rsa();
+  let certificate: Uint8Array;
+
+  beforeAll(async () => {
+    certificate = await selfSignedCertificate(keyPair);
+  });
+
+  it('produces signatures that verify against the certificate key, for every digest', async () => {
+    const vault = fakeVault(keyPair.privateKey, keyPair.publicKey);
+    const signer = await AzureKeyVaultSigner.create(vault, [certificate]);
+    const data = new TextEncoder().encode('the bytes a PDF signature covers');
+
+    for (const [digest, nodeHash, keyVaultAlgorithm, digestLength] of [
+      ['SHA-256', 'sha256', 'RS256', 32],
+      ['SHA-384', 'sha384', 'RS384', 48],
+      ['SHA-512', 'sha512', 'RS512', 64],
+    ] as const) {
+      const signature = await signer.sign(data, digest);
+
+      expect(verify(nodeHash, data, keyPair.publicKey, signature)).toBe(true);
+      expect(vault.calls.at(-1)).toEqual({ algorithm: keyVaultAlgorithm, digestLength });
+    }
+  });
+
+  it('describes itself as an RSA PKCS#1 v1.5 signer', async () => {
+    const signer = await AzureKeyVaultSigner.create(fakeVault(keyPair.privateKey, keyPair.publicKey), [certificate]);
+
+    expect(signer.keyType).toBe('RSA');
+    expect(signer.signatureAlgorithm).toBe('RSASSA-PKCS1-v1_5');
+  });
+
+  it('refuses a certificate that was issued for a different key', async () => {
+    const other = rsa();
+
+    await expect(
+      AzureKeyVaultSigner.create(fakeVault(other.privateKey, other.publicKey), [certificate]),
+    ).rejects.toThrow(/not issued for this Key Vault key/);
+  });
+
+  it('refuses to start without a certificate', async () => {
+    await expect(AzureKeyVaultSigner.create(fakeVault(keyPair.privateKey, keyPair.publicKey), [])).rejects.toThrow(
+      /no signing certificate/,
+    );
+  });
+
+  it('keeps the signing certificate out of the chain and passes intermediates through', async () => {
+    const intermediate = await selfSignedCertificate(rsa());
+
+    const alone = await AzureKeyVaultSigner.create(fakeVault(keyPair.privateKey, keyPair.publicKey), [certificate]);
+    const chained = await AzureKeyVaultSigner.create(fakeVault(keyPair.privateKey, keyPair.publicKey), [
+      certificate,
+      intermediate,
+    ]);
+
+    expect(alone.certificate).toEqual(certificate);
+    expect(alone.certificateChain).toBeUndefined();
+    expect(chained.certificateChain).toEqual([intermediate]);
+  });
+
+  it('seals a PDF whose CMS signature verifies over its byte range', async () => {
+    const signer = await AzureKeyVaultSigner.create(fakeVault(keyPair.privateKey, keyPair.publicKey), [certificate]);
+
+    const pdf = PDF.create();
+    pdf.addPage();
+
+    const { bytes } = await pdf.sign({ signer, reason: 'AzureKeyVaultSigner test', subFilter: 'ETSI.CAdES.detached' });
+
+    // Locate the signature dictionary the same way any validator does: /ByteRange names the two
+    // signed spans, and /Contents is the hex CMS between them.
+    const text = Buffer.from(bytes).toString('latin1');
+    const byteRange = /\/ByteRange\s*\[\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s*\]/.exec(text);
+
+    if (!byteRange) {
+      throw new Error('the signed PDF carries no /ByteRange');
+    }
+
+    const [start1, length1, start2, length2] = byteRange.slice(1).map(Number);
+    const signedBytes = Buffer.concat([
+      Buffer.from(bytes.subarray(start1, start1 + length1)),
+      Buffer.from(bytes.subarray(start2, start2 + length2)),
+    ]);
+    const hexContents = text.slice(start1 + length1 + 1, start2 - 1).replace(/0+$/, '');
+
+    const contentInfo = new pkijs.ContentInfo({ schema: asn1js.fromBER(Buffer.from(hexContents, 'hex')).result });
+    const signedData = new pkijs.SignedData({ schema: contentInfo.content });
+
+    const valid = await signedData.verify({ signer: 0, data: signedBytes, checkChain: false });
+
+    expect(valid).toBe(true);
+  });
+});
diff --git a/packages/signing/transports/azure-key-vault.ts b/packages/signing/transports/azure-key-vault.ts
new file mode 100644
index 0000000..eb9c409
--- /dev/null
+++ b/packages/signing/transports/azure-key-vault.ts
@@ -0,0 +1,203 @@
+import { createHash, createPublicKey, type KeyObject, X509Certificate } from 'node:crypto';
+import fs from 'node:fs';
+
+import { EnvironmentCredential } from '@azure/identity';
+import {
+  CryptographyClient,
+  type JsonWebKey,
+  KeyClient,
+  type SignatureAlgorithm as KeyVaultSignatureAlgorithm,
+  parseKeyVaultKeyIdentifier,
+} from '@azure/keyvault-keys';
+import { env } from '@documenso/lib/utils/env';
+import { type DigestAlgorithm, type KeyType, parsePem, type SignatureAlgorithm, type Signer } from '@libpdf/core';
+
+/**
+ * Azure Key Vault signing transport.
+ *
+ * The private key is a non-exportable RSA-HSM key in Azure Key Vault (Premium or Managed HSM).
+ * It never leaves the vault: this transport hashes the data locally and sends only the digest
+ * to Key Vault's `sign` operation, which returns a PKCS#1 v1.5 signature (`RS256` / `RS384` /
+ * `RS512`). That is the shape `@libpdf/core`'s `Signer` contract wants for RSA.
+ *
+ * Configuration:
+ *
+ * - `NEXT_PRIVATE_SIGNING_AZURE_KV_KEY_ID` — the full, VERSIONED key identifier, e.g.
+ *   `https://<vault>.vault.azure.net/keys/<name>/<version>`. A version is required: renewing a
+ *   Key Vault certificate creates a new key version, and an unversioned id would silently start
+ *   signing with a key the configured certificate chain does not describe.
+ * - `NEXT_PRIVATE_SIGNING_AZURE_KV_CERT_CHAIN_CONTENTS` (base64 of a PEM file) or
+ *   `NEXT_PRIVATE_SIGNING_AZURE_KV_CERT_CHAIN_FILE_PATH` — the signing certificate first, then
+ *   its intermediates. Public material; supplying it here means the identity needs no read
+ *   access to the vault's secrets, only the key's `sign` and `get` permissions.
+ * - Credentials come from `EnvironmentCredential`: `AZURE_TENANT_ID`, `AZURE_CLIENT_ID`, and
+ *   either `AZURE_CLIENT_CERTIFICATE_PATH` (preferred) or `AZURE_CLIENT_SECRET`. The identity
+ *   needs the "Key Vault Crypto User" role, ideally scoped to this one key.
+ *
+ * At startup the signer checks that the certificate's public key is the vault key's public key
+ * and refuses to start if not. A certificate issued for a different key would otherwise produce
+ * signatures that every validator rejects, discovered only after documents had been sealed.
+ */
+
+const KEY_VAULT_ALGORITHMS: Record<DigestAlgorithm, KeyVaultSignatureAlgorithm> = {
+  'SHA-256': 'RS256',
+  'SHA-384': 'RS384',
+  'SHA-512': 'RS512',
+};
+
+const NODE_HASHES: Record<DigestAlgorithm, string> = {
+  'SHA-256': 'sha256',
+  'SHA-384': 'sha384',
+  'SHA-512': 'sha512',
+};
+
+/**
+ * The two Key Vault operations the signer needs. Production uses {@link createKeyVaultClient};
+ * tests substitute a local implementation so the signer can be exercised without a vault.
+ */
+export type AzureKeyVaultSigningClient = {
+  /** The vault key's public key. */
+  getPublicKey(): Promise<KeyObject>;
+  /** Signs a precomputed digest and returns the raw PKCS#1 v1.5 signature. */
+  sign(algorithm: KeyVaultSignatureAlgorithm, digest: Uint8Array): Promise<Uint8Array>;
+};
+
+export class AzureKeyVaultSigner implements Signer {
+  readonly keyType: KeyType = 'RSA';
+  readonly signatureAlgorithm: SignatureAlgorithm = 'RSASSA-PKCS1-v1_5';
+
+  private constructor(
+    private readonly client: AzureKeyVaultSigningClient,
+    readonly certificate: Uint8Array,
+    readonly certificateChain: Uint8Array[] | undefined,
+  ) {}
+
+  /**
+   * @param certificates The signing certificate first, then its intermediates, all DER.
+   */
+  static async create(client: AzureKeyVaultSigningClient, certificates: Uint8Array[]): Promise<AzureKeyVaultSigner> {
+    const [certificate, ...chain] = certificates;
+
+    if (!certificate) {
+      throw new Error('Azure Key Vault signing: no signing certificate was provided');
+    }
+
+    const certificatePublicKey = new X509Certificate(Buffer.from(certificate)).publicKey;
+
+    if (certificatePublicKey.asymmetricKeyType !== 'rsa') {
+      throw new Error(
+        `Azure Key Vault signing: the signing certificate holds a ${certificatePublicKey.asymmetricKeyType} key; only RSA is supported`,
+      );
+    }
+
+    const vaultPublicKey = await client.getPublicKey();
+
+    if (!certificatePublicKey.equals(vaultPublicKey)) {
+      throw new Error(
+        'Azure Key Vault signing: the signing certificate was not issued for this Key Vault key ' +
+          '(their public keys differ). Check NEXT_PRIVATE_SIGNING_AZURE_KV_KEY_ID points at the key ' +
+          'version the certificate was issued against, and that the chain starts with the signing certificate.',
+      );
+    }
+
+    return new AzureKeyVaultSigner(client, certificate, chain.length > 0 ? chain : undefined);
+  }
+
+  async sign(data: Uint8Array, algorithm: DigestAlgorithm): Promise<Uint8Array> {
+    const keyVaultAlgorithm = KEY_VAULT_ALGORITHMS[algorithm];
+
+    if (!keyVaultAlgorithm) {
+      throw new Error(`Azure Key Vault signing: unsupported digest algorithm ${String(algorithm)}`);
+    }
+
+    const digest = createHash(NODE_HASHES[algorithm]).update(data).digest();
+
+    return await this.client.sign(keyVaultAlgorithm, new Uint8Array(digest));
+  }
+}
+
+/**
+ * The configured certificate chain, signing certificate first, as DER. Reads only local
+ * configuration, so the certificate status check can call it without touching the network.
+ */
+export const loadAzureKeyVaultCertificates = (): Uint8Array[] => {
+  const contents = env('NEXT_PRIVATE_SIGNING_AZURE_KV_CERT_CHAIN_CONTENTS');
+  const filePath = env('NEXT_PRIVATE_SIGNING_AZURE_KV_CERT_CHAIN_FILE_PATH');
+
+  let pem: string | undefined;
+
+  if (contents) {
+    pem = Buffer.from(contents, 'base64').toString('utf-8');
+  } else if (filePath) {
+    pem = fs.readFileSync(filePath).toString('utf-8');
+  }
+
+  if (!pem) {
+    throw new Error(
+      'Azure Key Vault signing: set NEXT_PRIVATE_SIGNING_AZURE_KV_CERT_CHAIN_CONTENTS or NEXT_PRIVATE_SIGNING_AZURE_KV_CERT_CHAIN_FILE_PATH',
+    );
+  }
+
+  const certificates = parsePem(pem)
+    .filter((block) => block.label === 'CERTIFICATE')
+    .map((block) => block.der);
+
+  if (certificates.length === 0) {
+    throw new Error('Azure Key Vault signing: the configured certificate chain contains no certificates');
+  }
+
+  return certificates;
+};
+
+const base64Url = (bytes: Uint8Array) => Buffer.from(bytes).toString('base64url');
+
+const toPublicKeyObject = (jwk: JsonWebKey): KeyObject => {
+  if (!jwk.n || !jwk.e) {
+    throw new Error(`Azure Key Vault signing: the vault key is not an RSA key (kty ${String(jwk.kty)})`);
+  }
+
+  return createPublicKey({ key: { kty: 'RSA', n: base64Url(jwk.n), e: base64Url(jwk.e) }, format: 'jwk' });
+};
+
+/** A {@link AzureKeyVaultSigningClient} backed by the Azure SDK. */
+export const createKeyVaultClient = (keyId: string): AzureKeyVaultSigningClient => {
+  const { vaultUrl, name, version } = parseKeyVaultKeyIdentifier(keyId);
+
+  if (!version) {
+    throw new Error(
+      'Azure Key Vault signing: NEXT_PRIVATE_SIGNING_AZURE_KV_KEY_ID must include the key version ' +
+        '(https://<vault>.vault.azure.net/keys/<name>/<version>)',
+    );
+  }
+
+  const credential = new EnvironmentCredential();
+  const keyClient = new KeyClient(vaultUrl, credential);
+  const cryptographyClient = new CryptographyClient(keyId, credential);
+
+  return {
+    getPublicKey: async () => {
+      const key = await keyClient.getKey(name, { version });
+
+      if (!key.key) {
+        throw new Error(`Azure Key Vault signing: Key Vault returned no key material for ${keyId}`);
+      }
+
+      return toPublicKeyObject(key.key);
+    },
+    sign: async (algorithm, digest) => {
+      const { result } = await cryptographyClient.sign(algorithm, digest);
+
+      return result;
+    },
+  };
+};
+
+export const createAzureKeyVaultSigner = async () => {
+  const keyId = env('NEXT_PRIVATE_SIGNING_AZURE_KV_KEY_ID');
+
+  if (!keyId) {
+    throw new Error('Azure Key Vault signing: NEXT_PRIVATE_SIGNING_AZURE_KV_KEY_ID is not set');
+  }
+
+  return await AzureKeyVaultSigner.create(createKeyVaultClient(keyId), loadAzureKeyVaultCertificates());
+};
