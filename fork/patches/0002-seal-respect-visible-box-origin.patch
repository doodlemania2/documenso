new file mode 100644
index 000000000..e7e33a2fd
--- /dev/null
+++ b/packages/lib/server-only/pdf/page-overlay-placement.ts
@@ -0,0 +1,189 @@
+import type { PDF, PDFPage } from '@libpdf/core';
+import { PdfArray, PdfDict, PdfNumber } from '@libpdf/core';
+
+/**
+ * A rectangle in a page's default (unrotated) user space.
+ */
+export type PageBox = {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+};
+
+export type PageOverlayPlacement = {
+  /** Overlay width, as the page is displayed (after `/Rotate`). */
+  width: number;
+  /** Overlay height, as the page is displayed (after `/Rotate`). */
+  height: number;
+  /** Where `drawPage` must put the overlay's origin, in user space. */
+  x: number;
+  y: number;
+  /** The page's `/Rotate`, normalised to 0, 90, 180 or 270. */
+  rotation: 0 | 90 | 180 | 270;
+};
+
+const LETTER_MEDIA_BOX: PageBox = { x: 0, y: 0, width: 612, height: 792 };
+
+// Guards against a malformed `/Parent` cycle.
+const MAX_PAGE_TREE_DEPTH = 64;
+
+/**
+ * Look up an inheritable page attribute (`MediaBox`, `CropBox`, `Rotate`),
+ * walking up the page tree as ISO 32000-1 7.7.3.4 requires.
+ */
+const getInheritableAttribute = (pdf: PDF, page: PDFPage, key: string) => {
+  const resolve = pdf.getObject.bind(pdf);
+
+  let node: PdfDict | undefined = page.dict;
+
+  for (let depth = 0; node && depth < MAX_PAGE_TREE_DEPTH; depth++) {
+    const value = node.get(key, resolve);
+
+    if (value !== undefined) {
+      return value;
+    }
+
+    const parent = node.get('Parent', resolve);
+    node = parent instanceof PdfDict ? parent : undefined;
+  }
+
+  return undefined;
+};
+
+/**
+ * Read a page box as a normalised rectangle, or `null` when it is missing or
+ * degenerate.
+ *
+ * Read directly rather than through `PDFPage.getMediaBox()`/`getCropBox()`:
+ * as of @libpdf/core 0.4.2 those return the upper-right corner as `width` and
+ * `height` and do not inherit from the page tree.
+ */
+const getPageBox = (pdf: PDF, page: PDFPage, key: 'MediaBox' | 'CropBox'): PageBox | null => {
+  const value = getInheritableAttribute(pdf, page, key);
+
+  if (!(value instanceof PdfArray) || value.length < 4) {
+    return null;
+  }
+
+  const resolve = pdf.getObject.bind(pdf);
+  const coords: number[] = [];
+
+  for (let i = 0; i < 4; i++) {
+    const coord = value.at(i, resolve);
+
+    if (!(coord instanceof PdfNumber)) {
+      return null;
+    }
+
+    coords.push(coord.value);
+  }
+
+  const [x1, y1, x2, y2] = coords;
+
+  const x = Math.min(x1, x2);
+  const y = Math.min(y1, y2);
+  const width = Math.abs(x2 - x1);
+  const height = Math.abs(y2 - y1);
+
+  if (width <= 0 || height <= 0) {
+    return null;
+  }
+
+  return { x, y, width, height };
+};
+
+/**
+ * The region of the page a viewer displays, in unrotated user space.
+ *
+ * Mirrors pdf.js's `Page.view` (which react-pdf renders, and which fields are
+ * positioned against): the CropBox clipped to the MediaBox, falling back to
+ * the MediaBox, and to US Letter when there is no usable MediaBox.
+ */
+export const getPageVisibleBox = (pdf: PDF, page: PDFPage): PageBox => {
+  const mediaBox = getPageBox(pdf, page, 'MediaBox') ?? LETTER_MEDIA_BOX;
+  const cropBox = getPageBox(pdf, page, 'CropBox');
+
+  if (!cropBox) {
+    return mediaBox;
+  }
+
+  const x = Math.max(cropBox.x, mediaBox.x);
+  const y = Math.max(cropBox.y, mediaBox.y);
+  const width = Math.min(cropBox.x + cropBox.width, mediaBox.x + mediaBox.width) - x;
+  const height = Math.min(cropBox.y + cropBox.height, mediaBox.y + mediaBox.height) - y;
+
+  if (width <= 0 || height <= 0) {
+    return mediaBox;
+  }
+
+  return { x, y, width, height };
+};
+
+/**
+ * The page's `/Rotate` (inherited if necessary), normalised the way pdf.js
+ * does: anything that is not a multiple of 90 is treated as 0.
+ */
+export const getPageRotation = (pdf: PDF, page: PDFPage): PageOverlayPlacement['rotation'] => {
+  const value = getInheritableAttribute(pdf, page, 'Rotate');
+  const rotate = value instanceof PdfNumber ? value.value : 0;
+
+  if (rotate % 90 !== 0) {
+    return 0;
+  }
+
+  // eslint-disable-next-line @typescript-eslint/consistent-type-assertions
+  return (((rotate % 360) + 360) % 360) as PageOverlayPlacement['rotation'];
+};
+
+/**
+ * Where a full-page overlay must be drawn so that it lines up with the page
+ * as a viewer displays it.
+ *
+ * The overlay is authored upright, at the displayed size of the visible box
+ * (width and height swapped for 90/270). `drawPage` rotates it about its
+ * origin by the page rotation, which leaves it covering a box anchored at
+ * (0, 0); the translation moves that onto the visible box, including the
+ * box's own lower-left corner, which need not be at the user-space origin.
+ */
+export const getPageOverlayPlacement = (pdf: PDF, page: PDFPage): PageOverlayPlacement => {
+  const box = getPageVisibleBox(pdf, page);
+  const rotation = getPageRotation(pdf, page);
+
+  const isSideways = rotation === 90 || rotation === 270;
+
+  const width = isSideways ? box.height : box.width;
+  const height = isSideways ? box.width : box.height;
+
+  switch (rotation) {
+    case 90:
+      return { width, height, rotation, x: box.x + box.width, y: box.y };
+    case 180:
+      return { width, height, rotation, x: box.x + box.width, y: box.y + box.height };
+    case 270:
+      return { width, height, rotation, x: box.x, y: box.y + box.height };
+    default:
+      return { width, height, rotation, x: box.x, y: box.y };
+  }
+};
+
+/**
+ * Draw a full-page overlay (e.g. from `insertFieldInPDFV2`) onto `page`, at
+ * the placement from `getPageOverlayPlacement`.
+ */
+export const drawPageOverlay = async (
+  pdf: PDF,
+  page: PDFPage,
+  overlay: PDF,
+  placement: PageOverlayPlacement,
+): Promise<void> => {
+  const embeddedPage = await pdf.embedPage(overlay, 0);
+
+  page.drawPage(embeddedPage, {
+    x: placement.x,
+    y: placement.y,
+    rotate: {
+      angle: placement.rotation,
+    },
+  });
+};
