diff --git a/packages/lib/server-only/pdf/page-overlay-placement.test.ts b/packages/lib/server-only/pdf/page-overlay-placement.test.ts
new file mode 100644
index 000000000..c7d13dd3a
--- /dev/null
+++ b/packages/lib/server-only/pdf/page-overlay-placement.test.ts
@@ -0,0 +1,257 @@
+import { PDF, type PDFPage, PdfArray, PdfDict, PdfNumber, PdfRef, PdfStream, rgb } from '@libpdf/core';
+import { describe, expect, it } from 'vitest';
+
+import { drawPageOverlay, getPageOverlayPlacement } from './page-overlay-placement';
+
+type Rect = [number, number, number, number];
+type Matrix = [number, number, number, number, number, number];
+
+type PageSpec = {
+  mediaBox: Rect;
+  cropBox?: Rect;
+  rotate?: number;
+  /** Put /MediaBox and /Rotate on the parent /Pages node instead of the page. */
+  inherit?: boolean;
+  /** The region pdf.js displays (`Page.view`), written out by hand. */
+  expectedView: Rect;
+};
+
+// A field as stored by Documenso: percentages of the displayed page, from its top-left corner.
+const FIELD = { positionX: 10, positionY: 20, width: 25, height: 5 };
+
+const rect = (values: Rect) => PdfArray.of(...values.map((value) => PdfNumber.of(value)));
+
+const buildSourcePdf = async (spec: PageSpec) => {
+  const pdf = PDF.create();
+  const page = pdf.addPage();
+  const target = spec.inherit ? page.dict.get('Parent', pdf.getObject.bind(pdf)) : page.dict;
+
+  if (!(target instanceof PdfDict)) {
+    throw new Error('Page has no parent /Pages node');
+  }
+
+  if (spec.inherit) {
+    page.dict.delete('MediaBox');
+  }
+
+  target.set('MediaBox', rect(spec.mediaBox));
+
+  if (spec.rotate !== undefined) {
+    target.set('Rotate', PdfNumber.of(spec.rotate));
+  }
+
+  if (spec.cropBox) {
+    page.dict.set('CropBox', rect(spec.cropBox));
+  }
+
+  return PDF.load(await pdf.save());
+};
+
+const firstPage = (pdf: PDF) => {
+  const page = pdf.getPage(0);
+
+  if (!page) {
+    throw new Error('PDF has no pages');
+  }
+
+  return page;
+};
+
+/**
+ * Seal-time overlay, as the seal handler does it: an upright overlay of the
+ * displayed page size with the field drawn where Konva would put it, drawn
+ * onto the page with `drawPageOverlay`.
+ */
+const sealOverlay = async (source: PDF, page: PDFPage) => {
+  const placement = getPageOverlayPlacement(source, page);
+
+  const overlay = PDF.create();
+  const overlayPage = overlay.addPage({ width: placement.width, height: placement.height });
+
+  overlayPage.drawRectangle({
+    x: (FIELD.positionX / 100) * placement.width,
+    y: placement.height - ((FIELD.positionY + FIELD.height) / 100) * placement.height,
+    width: (FIELD.width / 100) * placement.width,
+    height: (FIELD.height / 100) * placement.height,
+    color: rgb(0, 0, 0),
+  });
+
+  await drawPageOverlay(source, page, await PDF.load(await overlay.save()), placement);
+
+  return placement;
+};
+
+const multiply = (m: Matrix, n: Matrix): Matrix => [
+  m[0] * n[0] + m[1] * n[2],
+  m[0] * n[1] + m[1] * n[3],
+  m[2] * n[0] + m[3] * n[2],
+  m[2] * n[1] + m[3] * n[3],
+  m[4] * n[0] + m[5] * n[2] + n[4],
+  m[4] * n[1] + m[5] * n[3] + n[5],
+];
+
+const apply = (m: Matrix, x: number, y: number): [number, number] => [
+  m[0] * x + m[2] * y + m[4],
+  m[1] * x + m[3] * y + m[5],
+];
+
+const NUMBER = String.raw`[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?`;
+const CM = new RegExp(
+  `(${NUMBER})\\s+(${NUMBER})\\s+(${NUMBER})\\s+(${NUMBER})\\s+(${NUMBER})\\s+(${NUMBER})\\s+cm`,
+  'g',
+);
+
+/**
+ * The CTM the overlay XObject is painted with, read back from the saved
+ * page's content stream (the `cm` operators of the last `q ... Do Q` block).
+ */
+const getOverlayCtm = async (source: PDF): Promise<Matrix> => {
+  const pdf = await PDF.load(await source.save());
+  const resolve = pdf.getObject.bind(pdf);
+  const contents = firstPage(pdf).dict.get('Contents', resolve);
+
+  const streams =
+    contents instanceof PdfArray
+      ? contents.toArray().map((item) => (item instanceof PdfRef ? resolve(item) : item))
+      : [contents];
+
+  const text = streams
+    .filter((stream): stream is PdfStream => stream instanceof PdfStream)
+    .map((stream) => new TextDecoder().decode(stream.getDecodedData()))
+    .join('\n');
+
+  const paint = text.lastIndexOf(' Do');
+  const block = text.slice(text.lastIndexOf('q', paint), paint);
+
+  // Each `cm` pre-multiplies the CTM, so the last one written applies first.
+  return [...block.matchAll(CM)]
+    .map((match): Matrix => {
+      const [a, b, c, d, e, f] = match.slice(1, 7).map(Number);
+
+      return [a, b, c, d, e, f];
+    })
+    .reduceRight<Matrix>((ctm, m) => multiply(ctm, m), [1, 0, 0, 1, 0, 0]);
+};
+
+/**
+ * User space to displayed (top-left origin) coordinates, ported from pdf.js
+ * `PageViewport` at scale 1 — the transform react-pdf renders the signer's
+ * page with.
+ */
+const viewportTransform = (view: Rect, rotation: number): { transform: Matrix; width: number; height: number } => {
+  const centerX = (view[2] + view[0]) / 2;
+  const centerY = (view[3] + view[1]) / 2;
+
+  const [a, b, c, d] = (
+    {
+      0: [1, 0, 0, -1],
+      90: [0, 1, 1, 0],
+      180: [-1, 0, 0, 1],
+      270: [0, -1, -1, 0],
+    } as Record<number, [number, number, number, number]>
+  )[((rotation % 360) + 360) % 360];
+
+  const sideways = a === 0;
+  const offsetX = Math.abs(sideways ? centerY - view[1] : centerX - view[0]);
+  const offsetY = Math.abs(sideways ? centerX - view[0] : centerY - view[1]);
+
+  return {
+    transform: [a, b, c, d, offsetX - a * centerX - c * centerY, offsetY - b * centerX - d * centerY],
+    width: sideways ? view[3] - view[1] : view[2] - view[0],
+    height: sideways ? view[2] - view[0] : view[3] - view[1],
+  };
+};
+
+/** Bounding box of a rectangle's corners after `m`. */
+const mapRect = (m: Matrix, x1: number, y1: number, x2: number, y2: number) => {
+  const points = [apply(m, x1, y1), apply(m, x2, y1), apply(m, x1, y2), apply(m, x2, y2)];
+  const xs = points.map(([x]) => x);
+  const ys = points.map(([, y]) => y);
+
+  return { left: Math.min(...xs), top: Math.min(...ys), right: Math.max(...xs), bottom: Math.max(...ys) };
+};
+
+const expectRectClose = (actual: ReturnType<typeof mapRect>, expected: ReturnType<typeof mapRect>) => {
+  expect(actual.left).toBeCloseTo(expected.left, 6);
+  expect(actual.top).toBeCloseTo(expected.top, 6);
+  expect(actual.right).toBeCloseTo(expected.right, 6);
+  expect(actual.bottom).toBeCloseTo(expected.bottom, 6);
+};
+
+const LETTER: Rect = [0, 0, 612, 792];
+const CROP: Rect = [36, 72, 576, 720];
+
+const cases: Array<[string, PageSpec]> = [
+  ['plain Letter page', { mediaBox: LETTER, expectedView: LETTER }],
+  ['offset CropBox', { mediaBox: LETTER, cropBox: CROP, expectedView: CROP }],
+  ['offset CropBox, /Rotate 90', { mediaBox: LETTER, cropBox: CROP, rotate: 90, expectedView: CROP }],
+  ['offset CropBox, /Rotate 180', { mediaBox: LETTER, cropBox: CROP, rotate: 180, expectedView: CROP }],
+  ['offset CropBox, /Rotate 270', { mediaBox: LETTER, cropBox: CROP, rotate: 270, expectedView: CROP }],
+  ['offset CropBox, /Rotate -90', { mediaBox: LETTER, cropBox: CROP, rotate: -90, expectedView: CROP }],
+  ['offset MediaBox', { mediaBox: [100, 200, 712, 992], expectedView: [100, 200, 712, 992] }],
+  [
+    'CropBox overhanging the MediaBox',
+    { mediaBox: LETTER, cropBox: [-50, 100, 400, 900], expectedView: [0, 100, 400, 792] },
+  ],
+  [
+    'MediaBox and /Rotate 90 inherited from /Pages',
+    { mediaBox: [0, 0, 595, 842], rotate: 90, inherit: true, expectedView: [0, 0, 595, 842] },
+  ],
+];
+
+describe('getPageOverlayPlacement', () => {
+  it('sizes the overlay to the visible box, swapped for sideways pages', async () => {
+    const upright = await buildSourcePdf({ mediaBox: LETTER, cropBox: CROP, expectedView: CROP });
+    const sideways = await buildSourcePdf({ mediaBox: LETTER, cropBox: CROP, rotate: 90, expectedView: CROP });
+
+    expect(getPageOverlayPlacement(upright, firstPage(upright))).toEqual({
+      width: 540,
+      height: 648,
+      x: 36,
+      y: 72,
+      rotation: 0,
+    });
+
+    expect(getPageOverlayPlacement(sideways, firstPage(sideways))).toEqual({
+      width: 648,
+      height: 540,
+      x: 576,
+      y: 72,
+      rotation: 90,
+    });
+  });
+});
+
+describe('drawPageOverlay', () => {
+  it.each(cases)('%s: the field lands where pdf.js displayed it', async (_name, spec) => {
+    const source = await buildSourcePdf(spec);
+    const page = firstPage(source);
+
+    const placement = await sealOverlay(source, page);
+    const ctm = await getOverlayCtm(source);
+
+    const viewport = viewportTransform(spec.expectedView, spec.rotate ?? 0);
+    const overlayToDisplay = multiply(ctm, viewport.transform);
+
+    // The overlay covers exactly the displayed page...
+    expectRectClose(mapRect(overlayToDisplay, 0, 0, placement.width, placement.height), {
+      left: 0,
+      top: 0,
+      right: viewport.width,
+      bottom: viewport.height,
+    });
+
+    // ...so the field sits at the same percentages the signer saw.
+    const fieldLeft = (FIELD.positionX / 100) * placement.width;
+    const fieldTop = placement.height - (FIELD.positionY / 100) * placement.height;
+    const fieldRight = fieldLeft + (FIELD.width / 100) * placement.width;
+    const fieldBottom = fieldTop - (FIELD.height / 100) * placement.height;
+
+    expectRectClose(mapRect(overlayToDisplay, fieldLeft, fieldBottom, fieldRight, fieldTop), {
+      left: (FIELD.positionX / 100) * viewport.width,
+      top: (FIELD.positionY / 100) * viewport.height,
+      right: ((FIELD.positionX + FIELD.width) / 100) * viewport.width,
+      bottom: ((FIELD.positionY + FIELD.height) / 100) * viewport.height,
+    });
+  });
+});
