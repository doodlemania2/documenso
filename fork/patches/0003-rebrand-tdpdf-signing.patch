+import { BRAND_COMPANY_NAME, BRAND_SOURCE_URL, UPSTREAM_URL } from '@documenso/lib/constants/brand';
+import { cn } from '@documenso/ui/lib/utils';
+import { Trans } from '@lingui/react/macro';
+
+export type SiteFooterProps = {
+  className?: string;
+};
+
+/**
+ * Copyright, the source link, and what this service is built on.
+ *
+ * Documenso is AGPL-3.0 and so is this modified version of it. Section 13 of
+ * that licence requires a modified version offered over a network to tell its
+ * users where the corresponding source is, so the link is shown on the pages
+ * every user passes through rather than buried in a repository.
+ */
+export const SiteFooter = ({ className }: SiteFooterProps) => {
+  const linkClassName = 'underline hover:text-foreground';
+
+  return (
+    <footer className={cn('text-center text-muted-foreground/70 text-xs', className)}>
+      <p>
+        © {new Date().getFullYear()} {BRAND_COMPANY_NAME}
+      </p>
+      <p className="mt-1">
+        <a className={linkClassName} href={BRAND_SOURCE_URL} target="_blank" rel="noopener noreferrer">
+          GitHub
+        </a>
+        {' · '}
+        <Trans>
+          Based on{' '}
+          <a className={linkClassName} href={UPSTREAM_URL} target="_blank" rel="noopener noreferrer">
+            Documenso
+          </a>{' '}
+          (AGPL-3.0)
+        </Trans>
+      </p>
+    </footer>
+  );
+};
