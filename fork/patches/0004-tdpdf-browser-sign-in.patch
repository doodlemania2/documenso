@@ -0,0 +1,235 @@
+import { getOptionalSession } from '@documenso/auth/server/lib/utils/get-session';
+import { BRAND_NAME } from '@documenso/lib/constants/brand';
+import {
+  createConnectCode,
+  isAllowedRedirectUri,
+  isValidCodeChallenge,
+} from '@documenso/lib/server-only/connect/tdpdf-connect';
+import { getTeams } from '@documenso/lib/server-only/team/get-teams';
+import { canExecuteTeamAction } from '@documenso/lib/utils/teams';
+import { Button } from '@documenso/ui/primitives/button';
+import { msg } from '@lingui/core/macro';
+import { Trans } from '@lingui/react/macro';
+import { useEffect } from 'react';
+import { redirect, useFetcher } from 'react-router';
+
+import { appMetaTags } from '~/utils/meta';
+
+import type { Route } from './+types/connect.tdpdf';
+
+export function meta() {
+  return appMetaTags(msg`Connect TDPdf`);
+}
+
+type ConnectParams = {
+  codeChallenge: string;
+  state: string;
+  redirectUri: string;
+};
+
+const readParams = (source: URLSearchParams | FormData): ConnectParams | null => {
+  const codeChallenge = String(source.get('code_challenge') ?? '');
+  const state = String(source.get('state') ?? '');
+  const redirectUri = String(source.get('redirect_uri') ?? '');
+
+  if (!isValidCodeChallenge(codeChallenge) || !isAllowedRedirectUri(redirectUri)) {
+    return null;
+  }
+
+  if (state.length === 0 || state.length > 256) {
+    return null;
+  }
+
+  return { codeChallenge, state, redirectUri };
+};
+
+const getManageableTeams = async (userId: number) => {
+  const teams = await getTeams({ userId });
+
+  return teams.filter((team) => canExecuteTeamAction('MANAGE_TEAM', team.currentTeamRole));
+};
+
+export async function loader({ request }: Route.LoaderArgs) {
+  const url = new URL(request.url);
+
+  const session = await getOptionalSession(request);
+
+  if (!session.isAuthenticated) {
+    throw redirect(`/signin?returnTo=${encodeURIComponent(url.pathname + url.search)}`);
+  }
+
+  const params = readParams(url.searchParams);
+
+  if (!params) {
+    return { valid: false as const };
+  }
+
+  const teams = await getManageableTeams(session.user.id);
+
+  return {
+    valid: true as const,
+    params,
+    email: session.user.email,
+    teams: teams.map((team) => ({ id: team.id, name: team.name })),
+  };
+}
+
+/**
+ * Returns the URL to send the browser to rather than redirecting: the page's
+ * `form-action 'self'` policy would block a form post that ends at the
+ * loopback address, whereas a plain navigation is not covered by it.
+ */
+export async function action({ request }: Route.ActionArgs) {
+  const session = await getOptionalSession(request);
+
+  if (!session.isAuthenticated) {
+    return { error: 'unauthenticated' as const };
+  }
+
+  const formData = await request.formData();
+  const params = readParams(formData);
+
+  if (!params) {
+    return { error: 'invalid' as const };
+  }
+
+  const redirectTo = new URL(params.redirectUri);
+
+  redirectTo.searchParams.set('state', params.state);
+
+  if (formData.get('intent') !== 'allow') {
+    redirectTo.searchParams.set('error', 'access_denied');
+
+    return { redirectTo: redirectTo.toString() };
+  }
+
+  const teamId = Number(formData.get('teamId'));
+  const teams = await getManageableTeams(session.user.id);
+
+  if (!teams.some((team) => team.id === teamId)) {
+    return { error: 'invalid' as const };
+  }
+
+  const code = await createConnectCode({
+    userId: session.user.id,
+    teamId,
+    codeChallenge: params.codeChallenge,
+    redirectUri: params.redirectUri,
+  });
+
+  redirectTo.searchParams.set('code', code);
+
+  return { redirectTo: redirectTo.toString() };
+}
+
+export default function ConnectTdpdfPage({ loaderData }: Route.ComponentProps) {
+  const fetcher = useFetcher<typeof action>();
+
+  const redirectTo = fetcher.data && 'redirectTo' in fetcher.data ? fetcher.data.redirectTo : undefined;
+
+  useEffect(() => {
+    if (redirectTo) {
+      window.location.href = redirectTo;
+    }
+  }, [redirectTo]);
+
+  if (!loaderData.valid) {
+    return (
+      <div className="mx-auto w-full max-w-md text-center">
+        <h1 className="font-semibold text-2xl">
+          <Trans>This link is not valid</Trans>
+        </h1>
+        <p className="mt-3 text-muted-foreground text-sm">
+          <Trans>Go back to TDPdf and choose Connect again.</Trans>
+        </p>
+      </div>
+    );
+  }
+
+  const { params, teams, email } = loaderData;
+
+  if (redirectTo) {
+    return (
+      <div className="mx-auto w-full max-w-md text-center">
+        <h1 className="font-semibold text-2xl">
+          <Trans>You can return to TDPdf</Trans>
+        </h1>
+        <p className="mt-3 text-muted-foreground text-sm">
+          <Trans>This window can be closed.</Trans>
+        </p>
+      </div>
+    );
+  }
+
+  if (teams.length === 0) {
+    return (
+      <div className="mx-auto w-full max-w-md text-center">
+        <h1 className="font-semibold text-2xl">
+          <Trans>No team to connect</Trans>
+        </h1>
+        <p className="mt-3 text-muted-foreground text-sm">
+          <Trans>Your account is not allowed to create API tokens for any team.</Trans>
+        </p>
+      </div>
+    );
+  }
+
+  const isBusy = fetcher.state !== 'idle';
+
+  return (
+    <fetcher.Form method="post" className="mx-auto w-full max-w-md rounded-lg border bg-background p-6 shadow-sm">
+      <h1 className="font-semibold text-2xl">
+        <Trans>Connect TDPdf</Trans>
+      </h1>
+
+      <p className="mt-3 text-muted-foreground text-sm">
+        <Trans>
+          TDPdf on your computer is asking to send documents for signature and read their status as {email} in{' '}
+          {BRAND_NAME}.
+        </Trans>
+      </p>
+
+      <input type="hidden" name="code_challenge" value={params.codeChallenge} />
+      <input type="hidden" name="state" value={params.state} />
+      <input type="hidden" name="redirect_uri" value={params.redirectUri} />
+
+      <label className="mt-6 block font-medium text-sm" htmlFor="teamId">
+        <Trans>Team</Trans>
+      </label>
+      <select
+        id="teamId"
+        name="teamId"
+        className="mt-1 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"
+        defaultValue={teams[0].id}
+      >
+        {teams.map((team) => (
+          <option key={team.id} value={team.id}>
+            {team.name}
+          </option>
+        ))}
+      </select>
+
+      <p className="mt-3 text-muted-foreground text-xs">
+        <Trans>
+          This creates an API token named "TDPdf" that lasts one year. You can revoke it at any time under the team's
+          API tokens.
+        </Trans>
+      </p>
+
+      {fetcher.data && 'error' in fetcher.data && (
+        <p className="mt-3 text-destructive text-sm">
+          <Trans>Something went wrong. Go back to TDPdf and try again.</Trans>
+        </p>
+      )}
+
+      <div className="mt-6 flex justify-end gap-3">
+        <Button type="submit" name="intent" value="deny" variant="outline" disabled={isBusy}>
+          <Trans>Cancel</Trans>
+        </Button>
+        <Button type="submit" name="intent" value="allow" loading={isBusy}>
+          <Trans>Allow</Trans>
+        </Button>
+      </div>
+    </fetcher.Form>
+  );
+}
