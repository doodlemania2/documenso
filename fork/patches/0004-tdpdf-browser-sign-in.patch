index 0000000..150220a
--- /dev/null
+++ b/apps/remix/server/api/connect/connect.ts
@@ -0,0 +1,37 @@
+import { AppError } from '@documenso/lib/errors/app-error';
+import { redeemConnectCode } from '@documenso/lib/server-only/connect/tdpdf-connect';
+import { sValidator } from '@hono/standard-validator';
+import { Hono } from 'hono';
+import { z } from 'zod';
+
+import type { HonoEnv } from '../../router';
+
+const ZTokenRequestSchema = z.object({
+  code: z.string().min(1).max(2048),
+  code_verifier: z.string().min(1).max(256),
+});
+
+/**
+ * Token endpoint for the TDPdf desktop sign-in (see `tdpdf-connect.ts`).
+ * Called by the app itself, not a browser, so there is no CORS and no cookie.
+ */
+export const connectRoute = new Hono<HonoEnv>().post('/token', sValidator('json', ZTokenRequestSchema), async (c) => {
+  const { code, code_verifier: codeVerifier } = c.req.valid('json');
+
+  try {
+    const { token } = await redeemConnectCode({ code, codeVerifier });
+
+    c.header('Cache-Control', 'no-store');
+
+    return c.json({ token });
+  } catch (err) {
+    if (err instanceof AppError) {
+      // Deliberately one answer for every failure: it tells a guesser nothing.
+      return c.json({ error: 'invalid_grant' }, 400);
+    }
+
+    c.get('logger').error({ err }, 'TDPdf connect token exchange failed');
+
+    return c.json({ error: 'server_error' }, 500);
+  }
+});
