diff --git a/packages/lib/server-only/connect/tdpdf-connect.test.ts b/packages/lib/server-only/connect/tdpdf-connect.test.ts
new file mode 100644
index 0000000..1617f96
--- /dev/null
+++ b/packages/lib/server-only/connect/tdpdf-connect.test.ts
@@ -0,0 +1,89 @@
+import { createHash } from 'node:crypto';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('../public-api/create-api-token', () => ({
+  createApiToken: vi.fn(async () => ({ id: 1, token: 'api_test' })),
+}));
+
+import { createApiToken } from '../public-api/create-api-token';
+import {
+  createConnectCode,
+  isAllowedRedirectUri,
+  isValidCodeChallenge,
+  redeemConnectCode,
+  resetUsedConnectCodes,
+} from './tdpdf-connect';
+
+const verifier = 'v'.repeat(50);
+const challenge = createHash('sha256').update(verifier).digest('base64url');
+const redirectUri = 'http://127.0.0.1:53211/cb';
+
+describe('tdpdf connect', () => {
+  beforeEach(() => {
+    process.env.NEXTAUTH_SECRET = 'test-secret';
+    resetUsedConnectCodes();
+    vi.mocked(createApiToken).mockClear();
+  });
+
+  it('only allows loopback redirects with a port', () => {
+    expect(isAllowedRedirectUri('http://127.0.0.1:1234/cb')).toBe(true);
+    expect(isAllowedRedirectUri('http://localhost:1234/cb')).toBe(true);
+    expect(isAllowedRedirectUri('http://[::1]:1234/cb')).toBe(true);
+    expect(isAllowedRedirectUri('http://127.0.0.1/cb')).toBe(false);
+    expect(isAllowedRedirectUri('https://127.0.0.1:1234/cb')).toBe(false);
+    expect(isAllowedRedirectUri('http://evil.example:1234/cb')).toBe(false);
+    expect(isAllowedRedirectUri('http://127.0.0.1.evil.example:1234/cb')).toBe(false);
+    expect(isAllowedRedirectUri('http://user@127.0.0.1:1234/cb')).toBe(false);
+    expect(isAllowedRedirectUri('not a url')).toBe(false);
+  });
+
+  it('validates the challenge shape', () => {
+    expect(isValidCodeChallenge(challenge)).toBe(true);
+    expect(isValidCodeChallenge('short')).toBe(false);
+  });
+
+  it('refuses to create a code for a bad redirect or challenge', async () => {
+    await expect(
+      createConnectCode({ userId: 1, teamId: 2, codeChallenge: challenge, redirectUri: 'http://evil.example:1/' }),
+    ).rejects.toThrow();
+    await expect(createConnectCode({ userId: 1, teamId: 2, codeChallenge: 'x', redirectUri })).rejects.toThrow();
+  });
+
+  it('exchanges a code for a token for the right user and team', async () => {
+    const code = await createConnectCode({ userId: 7, teamId: 9, codeChallenge: challenge, redirectUri });
+
+    await expect(redeemConnectCode({ code, codeVerifier: verifier })).resolves.toEqual({ token: 'api_test' });
+    expect(createApiToken).toHaveBeenCalledWith(expect.objectContaining({ userId: 7, teamId: 9 }));
+  });
+
+  it('rejects a wrong verifier, and burns the code so it cannot be retried', async () => {
+    const code = await createConnectCode({ userId: 7, teamId: 9, codeChallenge: challenge, redirectUri });
+
+    await expect(redeemConnectCode({ code, codeVerifier: 'w'.repeat(50) })).rejects.toThrow();
+    await expect(redeemConnectCode({ code, codeVerifier: verifier })).rejects.toThrow();
+    expect(createApiToken).not.toHaveBeenCalled();
+  });
+
+  it('rejects a replayed code', async () => {
+    const code = await createConnectCode({ userId: 7, teamId: 9, codeChallenge: challenge, redirectUri });
+
+    await redeemConnectCode({ code, codeVerifier: verifier });
+    await expect(redeemConnectCode({ code, codeVerifier: verifier })).rejects.toThrow();
+    expect(createApiToken).toHaveBeenCalledTimes(1);
+  });
+
+  it('rejects a tampered code and one signed with another secret', async () => {
+    const code = await createConnectCode({ userId: 7, teamId: 9, codeChallenge: challenge, redirectUri });
+
+    await expect(redeemConnectCode({ code: `${code}x`, codeVerifier: verifier })).rejects.toThrow();
+
+    process.env.NEXTAUTH_SECRET = 'another-secret';
+    await expect(redeemConnectCode({ code, codeVerifier: verifier })).rejects.toThrow();
+  });
+
+  it('rejects a malformed verifier before touching the code', async () => {
+    const code = await createConnectCode({ userId: 7, teamId: 9, codeChallenge: challenge, redirectUri });
+
+    await expect(redeemConnectCode({ code, codeVerifier: 'short' })).rejects.toThrow();
+  });
+});
diff --git a/packages/lib/server-only/connect/tdpdf-connect.ts b/packages/lib/server-only/connect/tdpdf-connect.ts
new file mode 100644
index 0000000..6cd4968
--- /dev/null
+++ b/packages/lib/server-only/connect/tdpdf-connect.ts
@@ -0,0 +1,153 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+import { jwtVerify, SignJWT } from 'jose';
+
+import { AppError, AppErrorCode } from '../../errors/app-error';
+import { env } from '../../utils/env';
+import { createApiToken } from '../public-api/create-api-token';
+
+/**
+ * "Sign in with the browser" for the TDPdf desktop app.
+ *
+ * It is the OAuth authorization-code flow with PKCE (RFC 7636, S256) and a
+ * loopback redirect (RFC 8252), cut down to what one native client needs:
+ *
+ *   1. TDPdf opens /connect/tdpdf in the browser with a code challenge, a state
+ *      and a loopback redirect URI.
+ *   2. The signed-in user picks a team and approves. We mint a short-lived,
+ *      signed, single-use code bound to the user, team, challenge and redirect.
+ *   3. TDPdf posts the code and its verifier to /api/connect/token and receives
+ *      an ordinary API token.
+ *
+ * The code is a signed JWT rather than a database row so this needs no schema
+ * change. Single use is enforced in memory, which is sound for one server
+ * process; with several the 2-minute lifetime plus PKCE still bound a replay.
+ */
+
+const CODE_TTL_SECONDS = 120;
+const CODE_TYPE = 'tdpdf-connect';
+const TOKEN_EXPIRES_IN = 'ONE_YEAR';
+
+const usedCodes = new Map<string, number>();
+
+const getKey = () => {
+  const secret = env('NEXTAUTH_SECRET');
+
+  if (!secret) {
+    throw new AppError(AppErrorCode.UNKNOWN_ERROR, { message: 'NEXTAUTH_SECRET is not set' });
+  }
+
+  // Domain-separate from the session cookie key.
+  return createHash('sha256').update(`${CODE_TYPE}:${secret}`).digest();
+};
+
+const pruneUsedCodes = (now: number) => {
+  for (const [jti, expiresAt] of usedCodes) {
+    if (expiresAt <= now) {
+      usedCodes.delete(jti);
+    }
+  }
+};
+
+const s256 = (verifier: string) => createHash('sha256').update(verifier).digest('base64url');
+
+/** A S256 challenge is the base64url of a 32 byte hash: exactly 43 characters. */
+export const isValidCodeChallenge = (value: string) => /^[A-Za-z0-9_-]{43}$/.test(value);
+
+export const isValidCodeVerifier = (value: string) => /^[A-Za-z0-9._~-]{43,128}$/.test(value);
+
+/**
+ * Only a loopback address with an explicit port may receive the code, so it can
+ * never be sent to a host on the network (RFC 8252 section 7.3).
+ */
+export const isAllowedRedirectUri = (value: string) => {
+  try {
+    const url = new URL(value);
+
+    return (
+      url.protocol === 'http:' &&
+      ['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname) &&
+      url.port !== '' &&
+      url.username === '' &&
+      url.password === '' &&
+      url.hash === ''
+    );
+  } catch {
+    return false;
+  }
+};
+
+export type CreateConnectCodeOptions = {
+  userId: number;
+  teamId: number;
+  codeChallenge: string;
+  redirectUri: string;
+};
+
+export const createConnectCode = async ({ userId, teamId, codeChallenge, redirectUri }: CreateConnectCodeOptions) => {
+  if (!isValidCodeChallenge(codeChallenge) || !isAllowedRedirectUri(redirectUri)) {
+    throw new AppError(AppErrorCode.INVALID_REQUEST, { message: 'Invalid connect request' });
+  }
+
+  return await new SignJWT({ typ: CODE_TYPE, tid: teamId, cc: codeChallenge, ru: redirectUri })
+    .setProtectedHeader({ alg: 'HS256' })
+    .setSubject(String(userId))
+    .setJti(crypto.randomUUID())
+    .setIssuedAt()
+    .setExpirationTime(`${CODE_TTL_SECONDS}s`)
+    .sign(getKey());
+};
+
+export type RedeemConnectCodeOptions = {
+  code: string;
+  codeVerifier: string;
+};
+
+const invalidGrant = () => new AppError(AppErrorCode.UNAUTHORIZED, { message: 'Invalid or expired code' });
+
+export const redeemConnectCode = async ({ code, codeVerifier }: RedeemConnectCodeOptions) => {
+  if (!isValidCodeVerifier(codeVerifier)) {
+    throw invalidGrant();
+  }
+
+  const payload = await jwtVerify(code, getKey(), { algorithms: ['HS256'] })
+    .then((result) => result.payload)
+    .catch(() => {
+      throw invalidGrant();
+    });
+
+  const { typ, tid, cc, jti, sub, exp } = payload;
+
+  if (typ !== CODE_TYPE || typeof tid !== 'number' || typeof cc !== 'string' || !jti || !sub || !exp) {
+    throw invalidGrant();
+  }
+
+  const now = Date.now();
+
+  pruneUsedCodes(now);
+
+  // Burn the code before checking the verifier, so a wrong guess cannot be retried.
+  if (usedCodes.has(jti)) {
+    throw invalidGrant();
+  }
+
+  usedCodes.set(jti, exp * 1000);
+
+  const expected = Buffer.from(cc);
+  const actual = Buffer.from(s256(codeVerifier));
+
+  if (expected.length !== actual.length || !timingSafeEqual(expected, actual)) {
+    throw invalidGrant();
+  }
+
+  const { token } = await createApiToken({
+    userId: Number(sub),
+    teamId: tid,
+    tokenName: `TDPdf (${new Date(now).toISOString().slice(0, 10)})`,
+    expiresIn: TOKEN_EXPIRES_IN,
+  });
+
+  return { token };
+};
+
+/** Test hook: forget which codes were spent. */
+export const resetUsedConnectCodes = () => usedCodes.clear();
