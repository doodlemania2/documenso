  */
 export const ALLOWED_WEB_REDIRECT_URIS = ['https://app.foliolum.app/sign/callback'];
 
+/** What each web callback is called on the consent page and on the API token it creates. */
+const WEB_CLIENT_NAMES: Record<string, string> = {
+  'https://app.foliolum.app/sign/callback': 'Foliolum',
+};
+
+/**
+ * Who is asking, for the consent page and the token name: a web app by name and
+ * host, anything else (the loopback redirect) is the TDPdf desktop app.
+ */
+export const getConnectClient = (redirectUri: string) => {
+  const webName = WEB_CLIENT_NAMES[redirectUri];
+
+  if (webName) {
+    return { name: webName, host: new URL(redirectUri).host, isWeb: true as const };
+  }
+
+  return { name: 'TDPdf', host: null, isWeb: false as const };
+};
+
 /** Origins that may call the token endpoint from a browser. */
 export const ALLOWED_WEB_ORIGINS = ALLOWED_WEB_REDIRECT_URIS.map((uri) => new URL(uri).origin);
 
