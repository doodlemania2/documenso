# The upstream Documenso release our image is built from. Bump all three
# together, regenerate the patches against the new tag, and update
# patches/SHA256SUMS — see fork/README.md, "Upgrading".
UPSTREAM_REPO=https://github.com/documenso/documenso.git
UPSTREAM_TAG=v2.18.0
UPSTREAM_COMMIT=389390c884949fe27c240488a3259da3cdba93e0

# The local image tag build.sh produces. `-tdp.N` counts our builds of one
# upstream release; bump N whenever the patches change.
IMAGE_TAG=tdp/documenso:v2.18.0-tdp.3
